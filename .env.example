# =============================================================================
# Variáveis de ambiente — ecommerce-premium
# Copie este arquivo para .env.local e preencha com seus valores reais
# NUNCA comite .env.local no Git
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (obrigatório para todas as fases)
# Encontre em: https://supabase.com/dashboard/project/<id>/settings/api
# ---------------------------------------------------------------------------

# URL do projeto Supabase (pública — pode ir ao frontend)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co

# Chave anon/pública (pode ir ao frontend — limitada por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Chave de service role (SEGREDO — apenas no servidor, nunca no frontend)
# Bypassa RLS — usar somente em Route Handlers / Server Actions protegidos
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ---------------------------------------------------------------------------
# SupraPay (gateway de Pix ativo — https://app.suprapay.com.py)
# Credenciais geradas no painel da SupraPay (API Key, API Secret) + Webhook
# Secret (fornecido no registro do webhook, separado do API Secret).
# Cadastrar no painel da SupraPay:
#   https://SEUDOMINIO.com/api/payments/webhook/suprapay
# ---------------------------------------------------------------------------

SUPRAPAY_API_KEY=
SUPRAPAY_API_SECRET=
SUPRAPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Zendry (mantido só pro pagamento por CARTÃO — Pix é via SupraPay acima)
# Credenciais fornecidas pelo time do Zendry (developers.zendry.com)
# ---------------------------------------------------------------------------

ZENDRY_CLIENT_ID=
ZENDRY_CLIENT_SECRET=

# Segredo nosso, nunca fornecido pelo Zendry — vai como query param na URL de
# callback que a gente manda pro Zendry, pra autenticar o webhook (a doc do
# Zendry não documenta assinatura pro webhook de checkout). Gere com:
# openssl rand -hex 32
ZENDRY_WEBHOOK_SECRET=

# URL base da aplicação (para webhooks e redirects do Zendry)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# PicPay (LEGADO — mantido só como caminho de rollback do Zendry)
# Não preencher a não ser que precise desativar o Zendry temporariamente.
# Token da loja em: https://ecommerce.picpay.com (Vendas Online > Credenciais)
# ---------------------------------------------------------------------------

PICPAY_TOKEN=

# ---------------------------------------------------------------------------
# API de Frete (Fase 3 — não preencher agora)
# Melhor Envio: https://melhorenvio.com.br/developers
# ---------------------------------------------------------------------------

MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CEP_ORIGIN=01310100

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------

NODE_ENV=development
